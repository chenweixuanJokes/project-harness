{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ph:schema:project-harness",
  "title": "PH repository manifest",
  "description": "Machine-readable Project Harness inventory. All paths are repository-relative and canonical content lives under .agents/.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "template_version",
    "adapter_mode",
    "canonical",
    "adapters",
    "worktree",
    "memory",
    "skills",
    "speckit"
  ],
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "argv": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "properties": {
    "$schema": { "const": "./ph.schema.json" },
    "template_version": { "$ref": "#/$defs/semver" },
    "adapter_mode": { "enum": ["portable", "symlink"] },
    "canonical": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "agents", "manifest", "schema", "memory", "skills", "scripts"],
      "properties": {
        "root": { "const": ".agents" },
        "agents": { "const": ".agents/AGENTS.md" },
        "manifest": { "const": ".agents/ph.json" },
        "schema": { "const": ".agents/ph.schema.json" },
        "memory": { "const": ".agents/project-harness/memory" },
        "skills": { "const": ".agents/skills" },
        "scripts": { "const": ".agents/scripts" }
      }
    },
    "adapters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root_agents", "claude_entry", "claude_skills"],
      "properties": {
        "root_agents": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "path", "source"],
          "properties": {
            "mode": { "enum": ["managed_copy", "symlink"] },
            "path": { "const": "AGENTS.md" },
            "source": { "const": ".agents/AGENTS.md" }
          }
        },
        "claude_entry": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "path", "source"],
          "properties": {
            "mode": { "enum": ["import_stub", "symlink"] },
            "path": { "const": "CLAUDE.md" },
            "source": { "const": ".agents/AGENTS.md" }
          }
        },
        "claude_skills": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "path", "source", "include"],
          "properties": {
            "mode": { "enum": ["mirror_tree", "symlink"] },
            "path": { "const": ".claude/skills" },
            "source": { "const": ".agents/skills" },
            "include": { "const": "ph-*" }
          }
        }
      }
    },
    "worktree": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root",
        "gitignore_entry",
        "path_mode",
        "wip_prefix",
        "verify_commands",
        "max_changed_file_bytes"
      ],
      "properties": {
        "root": { "const": ".worktrees" },
        "gitignore_entry": { "const": "/.worktrees/" },
        "path_mode": { "const": "slug_hash" },
        "wip_prefix": { "const": "wip:" },
        "verify_commands": {
          "type": "array",
          "items": { "$ref": "#/$defs/argv" }
        },
        "max_changed_file_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1073741824
        }
      }
    },
    "memory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "directories", "frontmatter_fields"],
      "properties": {
        "root": { "const": ".agents/project-harness/memory" },
        "directories": {
          "type": "object",
          "additionalProperties": false,
          "required": ["temporary", "structured", "archive"],
          "properties": {
            "temporary": { "const": "temporary" },
            "structured": { "const": "structured" },
            "archive": { "const": "../archive/memory" }
          }
        },
        "frontmatter_fields": {
          "type": "array",
          "prefixItems": [
            { "const": "kind" },
            { "const": "status" },
            { "const": "created" },
            { "const": "updated" },
            { "const": "provenance" },
            { "const": "confidence" },
            { "const": "review_after" },
            { "const": "supersedes" },
            { "const": "sensitivity" },
            { "const": "topics" }
          ],
          "items": false
        }
      }
    },
    "skills": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "required_names"],
      "properties": {
        "root": { "const": ".agents/skills" },
        "required_names": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^ph-[a-z0-9]+(?:-[a-z0-9]+)*$" }
        }
      }
    },
    "speckit": {
      "type": "object",
      "description": "Upstream GitHub Spec Kit integration provenance: the pinned official release the ten ph-* spec skills were generated from.",
      "additionalProperties": false,
      "required": ["repository", "tag", "commit", "version", "skills"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "skills": {
          "type": "object",
          "description": "Installed skill name to upstream speckit-* name mapping, kept for future upgrades.",
          "minProperties": 1,
          "additionalProperties": { "type": "string", "pattern": "^speckit-[a-z0-9]+(?:-[a-z0-9]+)*$" }
        },
        "files": {
          "type": "object",
          "description": "Per-file content baselines recorded by the last ph_speckit install: managed repository-relative path to the sha256 of the installed bytes. A future upgrade may overwrite a differing file only while its current bytes still match this baseline; markers alone never prove the file was not edited.",
          "minProperties": 1,
          "additionalProperties": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "adapter_mode": { "const": "portable" } },
        "required": ["adapter_mode"]
      },
      "then": {
        "properties": {
          "adapters": {
            "properties": {
              "root_agents": { "properties": { "mode": { "const": "managed_copy" } } },
              "claude_entry": { "properties": { "mode": { "const": "import_stub" } } },
              "claude_skills": { "properties": { "mode": { "const": "mirror_tree" } } }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "adapter_mode": { "const": "symlink" } },
        "required": ["adapter_mode"]
      },
      "then": {
        "properties": {
          "adapters": {
            "properties": {
              "root_agents": { "properties": { "mode": { "const": "symlink" } } },
              "claude_entry": { "properties": { "mode": { "const": "symlink" } } },
              "claude_skills": { "properties": { "mode": { "const": "symlink" } } }
            }
          }
        }
      }
    }
  ]
}
