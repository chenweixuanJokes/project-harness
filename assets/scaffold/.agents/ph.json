{
  "$schema": "./ph.schema.json",
  "template_version": "1.1.15",
  "adapter_mode": "portable",
  "canonical": {
    "root": ".agents",
    "agents": ".agents/AGENTS.md",
    "manifest": ".agents/ph.json",
    "schema": ".agents/ph.schema.json",
    "memory": ".agents/memory",
    "skills": ".agents/skills",
    "scripts": ".agents/scripts"
  },
  "adapters": {
    "root_agents": {
      "mode": "managed_copy",
      "path": "AGENTS.md",
      "source": ".agents/AGENTS.md"
    },
    "claude_entry": {
      "mode": "import_stub",
      "path": "CLAUDE.md",
      "source": ".agents/AGENTS.md"
    },
    "claude_skills": {
      "mode": "mirror_tree",
      "path": ".claude/skills",
      "source": ".agents/skills",
      "include": "ph-*"
    }
  },
  "worktree": {
    "root": ".worktrees",
    "gitignore_entry": "/.worktrees/",
    "path_mode": "slug_hash",
    "wip_prefix": "wip:",
    "verify_commands": [],
    "max_changed_file_bytes": 10485760
  },
  "memory": {
    "root": ".agents/memory",
    "directories": {
      "temporary": "temporary",
      "structured": "structured",
      "archive": "archive"
    },
    "frontmatter_fields": [
      "kind",
      "status",
      "created",
      "updated",
      "provenance",
      "confidence",
      "review_after",
      "supersedes",
      "sensitivity",
      "topics"
    ]
  },
  "skills": {
    "root": ".agents/skills",
    "required_names": [
      "ph-init",
      "ph-merge-update",
      "ph-worktree-enter",
      "ph-worktree-exit",
      "ph-analyze",
      "ph-checklist",
      "ph-clarify",
      "ph-constitution",
      "ph-converge",
      "ph-implement",
      "ph-plan",
      "ph-specify",
      "ph-tasks",
      "ph-taskstoissues"
    ]
  },
  "speckit": {
    "repository": "https://github.com/github/spec-kit.git",
    "tag": "v1.0.8",
    "commit": "0cc9a6a1159471a3108b9bad718ba17006dd6039",
    "version": "1.0.8",
    "skills": {
      "ph-analyze": "speckit-analyze",
      "ph-checklist": "speckit-checklist",
      "ph-clarify": "speckit-clarify",
      "ph-constitution": "speckit-constitution",
      "ph-converge": "speckit-converge",
      "ph-implement": "speckit-implement",
      "ph-plan": "speckit-plan",
      "ph-specify": "speckit-specify",
      "ph-tasks": "speckit-tasks",
      "ph-taskstoissues": "speckit-taskstoissues"
    }
  }
}
